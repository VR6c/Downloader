# TVR Studio Environment Variables

# Backend API Base URL
# When deploying the frontend on Vercel, set this in your Vercel Project Settings > Environment Variables
# If you host the FastAPI Python server on Railway, Render, Fly.io, or a VPS:
# Example: VITE_API_BASE_URL=https://api.yourdomain.com
# If left empty, API calls will default to relative /api (local dev or reverse proxy)
VITE_API_BASE_URL=

# Vite Asset Base Path
# '/' for standard web hosting (Vercel, Netlify, Cloudflare Pages)
# './' for native Electron desktop builds
VITE_BASE=/

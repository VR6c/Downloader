# Repo-wide rules. App-specific rules live in "TVR Library Organizer/.gitignore".
# A pattern without a leading slash matches in every subfolder, so no "*/" copies are needed.

# Dependencies
node_modules/

# Python
.venv/
venv/
__pycache__/
*.py[cod]

# Vercel
.vercel/

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem

# Logs
*.log
.temp/

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Editors
.vscode/
.idea/
*.suo
*.sw?

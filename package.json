{
  "name": "tvr-workspace-root",
  "version": "2.0.0",
  "private": true,
  "description": "Root workspace proxy for TVR Studio",
  "scripts": {
    "install:all": "npm --prefix \"TVR Library Organizer\" install",
    "web:dev": "npm --prefix \"TVR Library Organizer\" run web:dev",
    "web:start": "npm --prefix \"TVR Library Organizer\" run web:start",
    "api": "npm --prefix \"TVR Library Organizer\" run api",
    "dev": "npm --prefix \"TVR Library Organizer\" run dev",
    "build": "npm --prefix \"TVR Library Organizer\" run build",
    "preview": "npm --prefix \"TVR Library Organizer\" run preview",
    "electron:dev": "npm --prefix \"TVR Library Organizer\" run electron:dev",
    "electron": "npm --prefix \"TVR Library Organizer\" run electron"
  }
}

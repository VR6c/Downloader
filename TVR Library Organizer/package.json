{
  "name": "tvr-studio",
  "version": "2.0.0",
  "description": "TVR Studio - Rekordbox DJ Library Organizer, Tag Editor & Media Downloader 2-in-1",
  "main": "electron/main.cjs",
  "author": "TVR Audio",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"node electron/waitAndStart.cjs\"",
    "electron": "electron electron/main.cjs",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('release',{recursive:true,force:true})\"",
    "build:mac": "npm run clean && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 -c.mac.identity=null --publish never && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --x64 -c.mac.identity=null --publish never",
    "build:mac:arm64": "npm run clean && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 -c.mac.identity=null --publish never",
    "build:mac:x64": "npm run clean && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --x64 -c.mac.identity=null --publish never",
    "build:win": "npm run clean && npm run build && electron-builder --win --publish never",
    "build:all": "npm run clean && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --x64 --win -c.mac.identity=null --publish never",
    "build:engine": "python3 python/build.py",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.cjs",
    "build:linux": "npm run clean && npm run build && electron-builder --linux --publish never",
    "test:unit": "node --test scripts/tests/updates.test.cjs"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "music-metadata": "^11.16.1",
    "node-id3": "^0.2.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^25.1.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "build": {
    "appId": "com.tvr.studio",
    "productName": "TVR Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "python/**/*",
      "!bin/**/*",
      "!python-dist/**/*",
      "package.json"
    ],
    "compression": "maximum",
    "extraResources": [
      {
        "from": "python-dist",
        "to": "python-dist"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-id3/**"
    ],
    "afterPack": "electron/afterPack.cjs",
    "icon": "build/icon.png",
    "mac": {
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        "dmg",
        "pkg"
      ],
      "extraResources": [
        {
          "from": "bin/mac",
          "to": "bin/mac"
        }
      ],
      "category": "public.app-category.music",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "pkg": {
      "scripts": "build/pkg-scripts"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "extraResources": [
        {
          "from": "bin/win",
          "to": "bin/win"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "bin/linux",
          "to": "bin/linux"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VR6c/Downloader.git"
  }
}

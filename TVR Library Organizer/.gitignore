# Dependencies
node_modules/

# Web build (Vite + PWA)
dist/
dev-dist/
*.tsbuildinfo

# Desktop packaging (electron-builder)
release/
release-ci/

# Python engine build (PyInstaller, see python/build.py)
python-dist/
build/engine/
build/pyinstaller_temp/
*.spec
*.spec.bak

# Bundled FFmpeg binaries (exceed GitHub's 100 MB file limit; fetched by `npm run fetch:ffmpeg`)
bin/mac/ffmpeg
bin/mac/ffprobe
bin/win/*.exe
bin/linux/ffmpeg
bin/linux/ffprobe

# Python virtual environments & bytecode
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Vercel (project link and local `vercel build` output)
.vercel/

# Environment variables & secrets (pushed to Vercel with `vercel env add`)
.env
.env.*
!.env.example
*.pem

# Logs & debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.temp/

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Editors
.vscode/
.idea/
*.sw?
